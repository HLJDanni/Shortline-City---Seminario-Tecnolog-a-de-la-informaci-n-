digraph ER {
  graph [rankdir=LR, splines=spline, nodesep=0.5, ranksep=1.1, bgcolor="white", fontname="Helvetica", pad=0.4];
  node [shape=plaintext, fontname="Helvetica"];
  edge [color="#5a6b78", arrowhead=crow, arrowtail=none, penwidth=1.2];
  labelloc="t"; fontsize=22; label=<<B>Shoreline City — Modelo de datos (PostgreSQL 18)</B>>;
  subgraph cluster_Seguridad { style="rounded,filled"; color="#ffffff"; fillcolor="#f7f9fb"; label=<<B>Seguridad</B>>; fontsize=14; fontcolor="#0b3d5c";
  roles [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#0b3d5c" COLSPAN="2"><FONT COLOR="white" POINT-SIZE="13"><B>roles</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eef3f6"><FONT POINT-SIZE="11">id</FONT></TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#666666">🔑 PK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">nombre</FONT></TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#666666">◆ U</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">permisos</FONT></TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#666666">{} JSON</FONT></TD></TR></TABLE>>];
  usuarios [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#0b3d5c" COLSPAN="2"><FONT COLOR="white" POINT-SIZE="13"><B>usuarios</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eef3f6"><FONT POINT-SIZE="11">id</FONT></TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#666666">🔑 PK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">email</FONT></TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#666666">◆ U</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">hashed&#95;password</FONT></TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#666666"> </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">rol&#95;id</FONT></TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#666666">🔗 FK</FONT></TD></TR></TABLE>>];
  auditoria [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#0b3d5c" COLSPAN="2"><FONT COLOR="white" POINT-SIZE="13"><B>auditoria</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eef3f6"><FONT POINT-SIZE="11">id</FONT></TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#666666">🔑 PK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">usuario&#95;id</FONT></TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#666666">🔗 FK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">accion</FONT></TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#666666"> </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">entidad</FONT></TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#666666"> </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">fecha</FONT></TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#666666"> </FONT></TD></TR></TABLE>>];
  }
  subgraph cluster_Personas { style="rounded,filled"; color="#ffffff"; fillcolor="#f7f9fb"; label=<<B>Personas</B>>; fontsize=14; fontcolor="#2a9d8f";
