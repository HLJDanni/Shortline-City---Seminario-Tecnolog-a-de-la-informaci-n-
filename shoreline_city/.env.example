# ============================================================
#  Shoreline City - Variables de entorno
# ============================================================
# Nombre de la aplicación
APP_NAME=Shoreline City
ENVIRONMENT=development

# --- Puertos en el host (cámbialos si ya tienes algo ocupándolos) ---
# La app quedará en http://localhost:${WEB_PORT}
WEB_PORT=8080
DB_PORT=5433

# --- Seguridad ---
# Genera una clave con: openssl rand -hex 32
SECRET_KEY=cambia-esta-clave-en-produccion-usa-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=480
# En producción con HTTPS pon COOKIE_SECURE=true
COOKIE_SECURE=false

# --- Base de datos (PostgreSQL 18) ---
POSTGRES_USER=shoreline
POSTGRES_PASSWORD=shoreline_pass
POSTGRES_DB=shoreline_city
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Si se define DATABASE_URL tiene prioridad sobre las variables anteriores.
# Para pruebas locales con SQLite: DATABASE_URL=sqlite:///./test.db
# DATABASE_URL=

# --- Usuario administrador inicial (sembrado automático) ---
FIRST_ADMIN_EMAIL=admin@shorelinecity.org
FIRST_ADMIN_PASSWORD=Admin1234
FIRST_ADMIN_NAME=Administrador General
